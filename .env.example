NODE_ENV=production
VERCEL=0
PORT=4173
APP_URL=https://digital360.store
CORS_ORIGINS=https://digital360.store
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=64-hex-characters-for-aes-256-gcm
COOKIE_SECURE=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zoomcue
MYSQL_USER=zoomcue_user
MYSQL_PASSWORD=replace-me
REDIS_URL=rediss://username:password@host:6380
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zoomcue-assets
# Optional shared house keys, used when a user has no BYOK connection
HOUSE_DEEPGRAM_KEY=
HOUSE_GOOGLE_KEY=
HOUSE_OPENAI_KEY=
HOUSE_ELEVENLABS_KEY=
