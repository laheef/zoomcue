NODE_ENV=production
PORT=4173
APP_URL=https://your-domain.example
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=64-hex-characters-for-aes-256-gcm
COOKIE_SECURE=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zoomcue
MYSQL_USER=zoomcue_user
MYSQL_PASSWORD=replace-me
REDIS_URL=redis://127.0.0.1:6379
# Optional shared house keys, used only when a user has no BYOK connection
HOUSE_DEEPGRAM_KEY=
HOUSE_GOOGLE_KEY=
HOUSE_OPENAI_KEY=
HOUSE_ELEVENLABS_KEY=
